[project]
name = "quant-qlib-mlops"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
authors = [
    { name = "zhanghaifeng9988", email = "541099040@qq.com" }
]
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.146.0",
    "numpy>=1.26,<2.0",
    "pandas>=2.1,<2.3",
    "pyqlib>=0.9.7,<0.10",
    "shap>=0.49.1",
    "uvicorn>=0.54.0",
    "yfinance>=1.7.0",
]

[project.scripts]
quant-qlib-mlops = "quant_qlib_mlops:main"

[build-system]
requires = ["uv_build>=0.12.5,<0.13.0"]
build-backend = "uv_build"
