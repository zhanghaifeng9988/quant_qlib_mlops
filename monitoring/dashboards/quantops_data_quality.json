          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n            symbol AS \"股票代码\",\n            TO_CHAR(trade_date, 'YYYY-MM-DD') AS \"交易日期\",\n            issue_type AS \"异常类型\",\n            field_name AS \"异常字段\",\n            field_value AS \"字段值\",\n            detected_at AS \"发现时间\"\n        FROM data_quality_issues\n        WHERE run_id = \n(SELECT run_id\n FROM data_quality_runs\n ORDER BY checked_at DESC\n LIMIT 1)\n\n        ORDER BY detected_at DESC",
          "refId": "A"
        }
