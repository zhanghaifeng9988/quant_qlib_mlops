        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "每日数据质量异常趋势",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mlops-pg"
      },
      "description": "每次质检运行发现的异常记录数量。随着每日运行积累形成趋势。",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlops-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH latest_runs AS (\n    SELECT DISTINCT ON (target_date)\n        target_date,\n        checked_at,\n        issue_count\n    FROM data_quality_runs\n    ORDER BY target_date, checked_at DESC\n)\nSELECT\n    checked_at AS \"time\",\n    issue_count::double precision AS value\nFROM latest_runs\nWHERE $__timeFilter(checked_at)\nORDER BY checked_at;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "行情滞后标的明细",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mlops-pg"
      },
      "description": "最新一次质检中行情日期滞后的标的清单。",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlops-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n            symbol AS \"股票代码\",\n            TO_CHAR(latest_date, 'YYYY-MM-DD') AS \"最新行情日期\",\n            TO_CHAR(target_date, 'YYYY-MM-DD') AS \"目标交易日\",\n            lag_trading_days AS \"滞后交易日数\",\n            detail AS \"说明\"\n        FROM data_freshness_metrics\n        WHERE run_id = \n(SELECT run_id\n FROM data_quality_runs\n ORDER BY checked_at DESC\n LIMIT 1)\n\n          AND status = '滞后'\n        ORDER BY lag_trading_days DESC, symbol",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
