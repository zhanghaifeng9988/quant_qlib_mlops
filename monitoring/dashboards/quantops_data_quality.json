    {
      "id": 5,
      "title": "数据新鲜度趋势",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mlops-pg"
      },
      "description": "按质检运行时间展示达标、滞后、异常和缺失标的数量变化。",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlops-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH latest_runs AS (\n    SELECT DISTINCT ON (target_date)\n        run_id,\n        target_date,\n        checked_at\n    FROM data_quality_runs\n    ORDER BY target_date, checked_at DESC\n)\nSELECT\n    r.checked_at AS \"time\",\n    f.status AS metric,\n    COUNT(*)::double precision AS value\nFROM latest_runs r\nJOIN data_freshness_metrics f\n    ON r.run_id = f.run_id\nWHERE $__timeFilter(r.checked_at)\nGROUP BY r.checked_at, f.status\nORDER BY r.checked_at;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "异常类型分布",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mlops-pg"
      },
      "description": "最新一次质检发现的各类数据异常数量。",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlops-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n            issue_type,\n            COUNT(*)::bigint AS \"异常数量\"\n        FROM data_quality_issues\n        WHERE run_id = \n(SELECT run_id\n FROM data_quality_runs\n ORDER BY checked_at DESC\n LIMIT 1)\n\n        GROUP BY issue_type\n        ORDER BY COUNT(*) DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
