  "panels": [
    {
      "id": 1,
      "title": "数据新鲜度达标率",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mlops-pg"
      },
      "description": "最新一次质检运行中，行情日期达到目标交易日的标的比例。",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mlops-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(\n            100.0 * COUNT(*) FILTER (WHERE status = '达标')\n            / NULLIF(COUNT(*), 0), 2\n        ) AS value\n        FROM data_freshness_metrics\n        WHERE run_id = \n(SELECT run_id\n FROM data_quality_runs\n ORDER BY checked_at DESC\n LIMIT 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
